#!/bin/sh
# Ordinary optional wrapper, generated by CMake for the configured launcher. NEVER setuid this shell script.
# Usage: with-craft command [argument ...]
# Runs a command with a new user TGT selected in its environment.
set -eu
if [ "$#" -eq 0 ]; then
    printf '%s\n' 'Usage: with-craft command [argument ...]' >&2
    exit 2
fi
cache=$(@CRAFT_LAUNCHER@) || exit "$?"
KRB5CCNAME=$cache
export KRB5CCNAME
exec "$@"
