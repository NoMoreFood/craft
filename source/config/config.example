# /etc/craft/config - root:root 0644; protected root-owned parents.
# Public policy is readable by callers; keep keys/keytabs separately private.
# Select and order the modes that fit this installation; only listed modes may run.
# BYOC (home) needs enabled/modes/domain/realm and shared ticket policy only.
# Full-line comments only. Shipped disabled; review all placeholders.
enabled=no

domain=domain.local
realm=DOMAIN.LOCAL
netbios=DOMAIN

# BYOC (Bring Your Own Cert) = home; Enrollment Agent = enrollment; Key Trust = key_trust.
# Constrained Delegation = constrained_delegation.
# ORDERED MODES: home, enrollment, key_trust, constrained_delegation. No implicit default or duplicates.
# Try the next enabled mode after a reported acquisition failure; stop at the first success.
# Invalid policy, worker interruption, unconfirmed key cleanup and cache publication errors stop the request.
# Configure prerequisites for every enabled mode. Broker modes share one account/keytab and request cooldown.
# All broker modes need the setuid launcher, the dedicated service account and /run/craft.
modes=home enrollment

# CONSTRAINED DELEGATION (modes=constrained_delegation): no certificate-mode fallback.
# Adding another mode explicitly allows that mode to obtain a TGT after a service acquisition failure.
# Use a dedicated broker keytab and enable protocol transition plus constrained delegation
# to these exact services on the broker AD account. No PKINIT, LDAP or CES is used.
# Every target must succeed; only final service tickets are published, without any TGT/evidence.
# service_principal=CRAFT/broker.domain.local@DOMAIN.LOCAL
# service_spns=cifs/files.domain.local@DOMAIN.LOCAL HTTP/portal.domain.local@DOMAIN.LOCAL
# service_ticket_seconds=36000
# KDC-shortened service lifetimes are accepted. TGT/certificate settings do not govern this mode.

# KEY TRUST (modes=key_trust): writable domain controller for msDS-KeyCredentialLink.
# Use the SAME DC that serves as the KDC in krb5.conf so the written key is seen immediately.
# Requires service_principal and submitter.keytab below for the LDAP/GSSAPI bind.
# Only ldap:// is accepted: the bind's GSSAPI layer protects the connection, and
# Active Directory refuses that layer inside TLS (ldaps://).
# kt_dc_url=ldap://dc01.domain.local

# ENROLLMENT AGENT (modes=enrollment): use the actual template msPKI-Cert-Template-OID,
# not its display name.
template_oid=1.3.6.1.4.1.311.21.8.999.1

# Generated CN for the enrollment CSR or Key Trust local certificate: {user}, {upn}, {domain} supported.
# {upn} uses the resolved AD UPN, including an alternate suffix.
# Final CN must be 1-64 printable ASCII characters; the CA may override it.
# This does not change the directory UPN or authorize enrollee-supplied identities.
certificate_cn={user}

# Generated RSA key bit length for enrollment and key_trust.
# Accepts 2048, 3072, or 4096. Defaults to 3072.
# For enrollment it must be at least the template's minimum key size, or the CA refuses the request.
# key_bits=3072

# ENROLLMENT only: AD CS CES endpoint, not legacy /certsrv. Replace with the real endpoint.
# It must be a plain https:// URL without credentials, query or fragment. The server is
# verified against https-trust.pem only; add an optional https-crls.pem bundle to also
# require an unrevoked CES server chain (it must then cover every CA in that chain).
ces_url=https://ces.domain.local/IssuingCA_CES_Kerberos/service.svc/CES
ces_auth=negotiate
# Directory/submission or constrained-delegation broker account; matches submitter.keytab:
# enrollment (directory UPN lookup and CES Negotiate) and key_trust (msDS-KeyCredentialLink write).
service_principal=svc-linux-enroll@DOMAIN.LOCAL

# Alternative: ces_auth=mtls and a CES client-certificate endpoint, with
# separate https-client.pem/.key in addition to the directory keytab.
#
# Active Directory Global Catalog lookup configuration (optional).
# Defaults: gc_url=ldap://<domain>:3268, gc_base_dn derived from domain (e.g. DC=domain,DC=local).
# gc_url must likewise be an ldap:// URL.
# gc_url=ldap://domain.local:3268
# gc_base_dn=DC=domain,DC=local

# Ticket and renewal lifetimes match the most permissive DISA STIG options:
# DISA STIG limits user ticket lifetime (MaxTicketAge) to 10 hours (36000s) and
# user ticket renewal (MaxRenewAge) to 7 days (604800s).
# Note: RFC 4556 constrains initial ticket lifetime by client certificate validity,
# so enrollment certificate caps also default to 10 hours.
# Home mode accepts ordinary certificate validity; KDC ticket policy still applies.
# renew_seconds must exceed tgt_seconds, or be 0 to disable renewal.
tgt_seconds=36000
renew_seconds=604800
require_full_tgt_lifetime=yes

# Enrollment CA/template must issue certificates no longer than 10 hours TOTAL.
# These caps do not apply to supplied home certificates.
# These are acceptance caps, not a request to change CA validity policy.
# CA backdating consumes part of the 10-hour total; it is not an extra allowance.
cert_remaining_max_seconds=36000
cert_total_max_seconds=36000
minimum_interval_seconds=60
